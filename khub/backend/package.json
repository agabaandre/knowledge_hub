{
  "name": "@khub/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Knowledge Hub API server (Express + knex, MySQL or PostgreSQL)",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/server.js",
    "start": "node --env-file-if-exists=../.env src/server.js",
    "migrate": "node --env-file-if-exists=../.env scripts/migrate.js",
    "migrate:rollback": "node --env-file-if-exists=../.env scripts/migrate.js --rollback",
    "migrate:from-laravel": "node --env-file-if-exists=../.env scripts/migrate-from-laravel.js",
    "test": "node --test tests/",
    "lint": "eslint src scripts tests",
    "seed:demo": "node --env-file-if-exists=../.env scripts/seed-demo.js",
    "verify:counts": "node --env-file-if-exists=../.env scripts/verify-counts.js",
    "smoke": "node scripts/smoke-test.js",
    "admin:create": "node --env-file-if-exists=../.env scripts/create-admin.js"
  },
  "dependencies": {
    "@khub/shared": "*",
    "adm-zip": "^0.5.16",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "multer": "^2.0.2",
    "mysql2": "^3.15.3",
    "pg": "^8.16.3",
    "pino": "^9.13.1",
    "pino-http": "^10.5.0",
    "prom-client": "^15.1.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.4.0",
    "pino-pretty": "^13.1.2"
  }
}
