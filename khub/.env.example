# ---- Application ----
NODE_ENV=development
APP_URL=http://localhost:3000
BACKEND_PORT=4000
FRONTEND_PORT=3000
# Secret used to sign JWT sessions. Generate: openssl rand -hex 32
APP_SECRET=change-me

# ---- Database (default connection, used by every site unless site.json overrides it) ----
# DB_CLIENT is "mysql2" or "pg"
DB_CLIENT=mysql2
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=knowledge_hub
DB_USERNAME=root
DB_PASSWORD=

# ---- Storage (same layout as the Laravel hub) ----
# Each site gets {HUB_DATA_ROOT}/{site-id}/files and {HUB_DATA_ROOT}/{site-id}/backups/sql
HUB_DATA_ROOT=/var/khubdata
# Override the derived site id for the default site (otherwise derived from APP_URL)
# HUB_SITE_ID=

# ---- Sites ----
# Directory containing one folder per site (site.json + optional overrides)
SITES_DIR=./sites
# How a request is matched to a site: "path" (khub.org/nigeria) or "host" (nigeria.khub.org)
SITE_RESOLUTION=path

# ---- Cache ----
# Optional shared Redis cache (settings, menus, lookups, blocked IPs, …).
# Leave empty to cache in-process only; with several API instances set e.g. redis://127.0.0.1:6379
REDIS_URL=
# Key prefix separating instances that share one Redis (defaults to "khub")
# REDIS_PREFIX=khub

# ---- Metrics ----
METRICS_ENABLED=true
# Protect /metrics (Prometheus) with a bearer token; leave empty to allow unauthenticated scrape
METRICS_TOKEN=

# ---- Laravel → Node migration (scripts/migrate-from-laravel.js) ----
SOURCE_DB_CLIENT=mysql2
SOURCE_DB_HOST=127.0.0.1
SOURCE_DB_PORT=3308
SOURCE_DB_DATABASE=knowledge_hub
SOURCE_DB_USERNAME=root
SOURCE_DB_PASSWORD=
# Laravel site id whose /var/khubdata folder holds the uploads (see HubSiteIdentifier)
SOURCE_SITE_ID=localhost-8081
