<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /knowledge_hub/front_end/

    # Do not expose the Next source tree
    RewriteRule ^(src|node_modules|\.next|apache-front-end\.conf)(/|$) - [F,L]

    # Real files (proxy script, later static export)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Staff-portal style shim: send the subdirectory to the Node app
    RewriteRule ^ front-end-proxy.php [L,QSA]
</IfModule>
