<?php 

use Illuminate\Support\Facades\Http;
use Illuminate\Http\Response;
use Illuminate\Support\Facades\Log;

if (!function_exists('StreamRemotePdf')) {
    /**
     * Streams a remote PDF file to the browser.
     *
     * @param string $url The URL of the remote PDF.
     * @param string $filename The desired filename for the PDF.
     * @return \Illuminate\Http\Response
     */
    function StreamRemotePdf(string $url, string $filename = 'document.pdf'): Response
    {
        try {
            // SSRF-safe fetch: public http(s) targets only, redirects re-validated, TLS verified.
            $result = \App\Support\SafeUrlFetcher::fetch($url);

            if ($result === null) {
                abort(400, 'Invalid URL provided.');
            }
            if ($result['status'] !== 200 || ! str_starts_with(ltrim($result['body']), '%PDF-')) {
                abort(404, 'Failed to fetch the PDF file.');
            }

            $safeName = preg_replace('/[^A-Za-z0-9._-]/', '_', $filename) ?: 'document.pdf';

            return response($result['body'], 200, [
                'Content-Type' => 'application/pdf',
                'Content-Disposition' => 'inline; filename="' . $safeName . '"',
            ]);
        } catch (\Symfony\Component\HttpKernel\Exception\HttpException $e) {
            throw $e;
        } catch (\Exception $e) {
            Log::error('Error streaming PDF: ' . $e->getMessage());
            abort(500, 'An error occurred while streaming the PDF.');
        }
    }
}
