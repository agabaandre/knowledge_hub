  `show_events` tinyint(1) NOT NULL DEFAULT '0',
  `show_top_searches` tinyint(1) NOT NULL DEFAULT '0',
  `show_tags` tinyint(1) NOT NULL DEFAULT '0',
  `show_quotes` tinyint(1) NOT NULL DEFAULT '0',
  `show_health_themes` tinyint(1) NOT NULL DEFAULT '1',
