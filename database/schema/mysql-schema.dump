  `primary_font` varchar(100) DEFAULT NULL,
  `default_font_color` varchar(20) DEFAULT NULL,
  `front_body_font_size` varchar(10) DEFAULT NULL,
  `admin_body_font_size` varchar(10) DEFAULT NULL,
  `translate_button_filled` tinyint(1) NOT NULL DEFAULT '1',
  `translate_button_text_color` varchar(20) NOT NULL DEFAULT '#ffffff',
  `header_logo_inverse` tinyint(1) NOT NULL DEFAULT '0',
  `footer_logo_inverse` tinyint(1) NOT NULL DEFAULT '0',
  `nav_style` varchar(20) NOT NULL DEFAULT 'colored',
  `nav_link_color` varchar(20) DEFAULT NULL,
  `nav_link_hover_color` varchar(20) DEFAULT NULL,
  `nav_link_active_color` varchar(20) DEFAULT NULL,
