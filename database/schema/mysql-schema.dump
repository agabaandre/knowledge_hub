  `show_publication_card_file_type_badge` tinyint(1) NOT NULL DEFAULT '1',
  `communities_listing_show_participants` tinyint(1) NOT NULL DEFAULT '1',
  `communities_listing_max_faces` tinyint unsigned NOT NULL DEFAULT '8',
  `blocked_email_domains` text,
  PRIMARY KEY (`id`),
  KEY `setting_status_index` (`status`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;
