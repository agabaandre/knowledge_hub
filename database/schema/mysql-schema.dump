  `theme_cards_per_row` tinyint unsigned NOT NULL DEFAULT '4',
  `show_quiz` tinyint(1) NOT NULL DEFAULT '0',
  `publication_min_words` int NOT NULL DEFAULT '150',
  `publication_required_fields` json DEFAULT NULL,
  `enable_version_submission` tinyint(1) NOT NULL DEFAULT '1',
  `enable_microsoft_login` tinyint(1) NOT NULL DEFAULT '1',
  `enable_google_login` tinyint(1) NOT NULL DEFAULT '1',
  `enable_linkedin_login` tinyint(1) NOT NULL DEFAULT '1',
  `allow_email_password_accounts_social_login` tinyint(1) NOT NULL DEFAULT '1',
  `block_disposable_email_registration` tinyint(1) NOT NULL DEFAULT '1',
