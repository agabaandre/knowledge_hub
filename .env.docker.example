APP_NAME="Knowledge Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_INSTALLED=false
INSTALLER_DISABLED=false
DOCKER=true

# Persistent data outside the container (mount ./khubdata:/var/khubdata in compose).
# Each hub gets /var/khubdata/{site-id}/ — derived from APP_URL unless set explicitly.
# Example: APP_URL=http://localhost:8080/andrew → HUB_SITE_ID=localhost-8080-andrew
# HUB_SITE_ID=
# HUB_FILES_ROOT=
# HUB_SQL_BACKUP_ROOT=

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=knowledge_hub
DB_USERNAME=root
DB_PASSWORD=password

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DRIVER=public
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email driver: exchange (Microsoft Graph) or smtp. Installer step 4 can override these.
EMAIL_DRIVER=exchange

MAIL_MAILER=smtp
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SENDER_NAME="${APP_NAME}"

# Exchange / Microsoft Graph OAuth (when EMAIL_DRIVER=exchange)
EXCHANGE_TENANT_ID=
EXCHANGE_CLIENT_ID=
EXCHANGE_CLIENT_SECRET=
EXCHANGE_REDIRECT_URI="${APP_URL}/auth/microsoft/callback"
EXCHANGE_SCOPE=https://graph.microsoft.com/.default
EXCHANGE_AUTH_METHOD=client_credentials

SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=masterKey

DISABLE_TELESCOPE=true
SITE_LIVE=false
STATES_ENABLED=false
ADMIN_UNITS_ENABLED=true
FIX_PERMISSIONS_ON_BOOT=true

# Country hub only — never enable on continental production.
# Allows wipe UI on admin/publications/pending and: php artisan khub:wipe-content --force --phrase=WIPE
# HUB_ALLOW_CONTENT_WIPE=false
# HUB_CONTENT_WIPE_PHRASE=WIPE

# Bare-metal country hub auto-provision (continental only). Never commit real secrets.
# FEDERATION_PROVISION_ENABLED=false
# FEDERATION_PROVISION_SOURCE_ROOT=/var/www/khub.africacdc.org
# FEDERATION_PROVISION_TARGET_PARENT=/var/www
# FEDERATION_PROVISION_APACHE_VHOST=/etc/apache2/sites-available/khub.africacdc.org-le-ssl.conf
# FEDERATION_PROVISION_PUBLIC_BASE_URL=https://khub.africacdc.org
# FEDERATION_PROVISION_SUDO_PASSWORD=
# FEDERATION_PROVISION_MYSQL_HOST=127.0.0.1
# FEDERATION_PROVISION_MYSQL_PORT=3306
# FEDERATION_PROVISION_MYSQL_ADMIN_USER=root
# FEDERATION_PROVISION_MYSQL_ADMIN_PASSWORD=
# FEDERATION_PROVISION_WEB_USER=www-data
# FEDERATION_PROVISION_WEB_GROUP=www-data
# FEDERATION_PROVISION_PHP_BINARY=/usr/bin/php
